package SWEA_richguyPJT_1859;

import java.io.File;
import java.io.FileNotFoundException;
import java.util.Scanner;
import java.util.Stack;

public class Solution_01 {

	public static void main(String[] args) throws FileNotFoundException {
		File file = new File("./src/SWEA_richguyPJT_1859/input.txt");
		Scanner sc = new Scanner(file);
//		Scanner sc = new Scanner(System.in);
		
		int T = sc.nextInt(); // 테스트케이스 수
		for (int tc = 1; tc < T+1; tc++) {
			int N = sc.nextInt();
			
			Stack<Integer> S = new Stack<>();
			for (int i = 0; i < N; i++) {
				S.add(sc.nextInt());
			}
			
			int R = 0;
			int num1 = 0;
			int max = 0;
			while(!S.isEmpty()) {
				num1 += S.peek();
				int num2 = S.pop();
				if (num2 > max) {
					max = num2;
				}
				if (!S.isEmpty() && S.peek() > num1) {
					num1 = 0;
				} else if (!S.isEmpty() && S.peek() == num1) {
					continue;
				} else if (!S.isEmpty()){
					R += num1 - S.pop();
					num1 = 0;
				}
			}
			
			System.out.printf("#%d %d\n", tc, R);
		} // for : 테스트 결과 출력
	}

}
