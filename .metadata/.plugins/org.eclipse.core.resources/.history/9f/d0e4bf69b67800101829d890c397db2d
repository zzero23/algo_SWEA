package SWEA_twoInt_1959;

import java.io.File;
import java.io.FileNotFoundException;
import java.util.Arrays;
import java.util.Scanner;

public class Solution_01 {

	public static void main(String[] args) throws FileNotFoundException {
		File file = new File("./src/SWEA_twoInt_1959/input.txt");
		Scanner sc = new Scanner(file);
//		Scanner sc = new Scanner(System.in);
		
		int T = sc.nextInt(); // 테스트케이스 수
		for (int tc = 1; tc < 2; tc++) {
			int N = sc.nextInt(); // 첫번째 숫자열
			int M = sc.nextInt(); // 두번째 숫자열
			
			int[] NI = new int[N];
			int[] MI = new int[M];
			for (int i = 0; i < N; i++) {
				NI[i] = sc.nextInt();
			} // for : 첫번째 숫자열
			for (int i = 0; i < M; i++) {
				MI[i] = sc.nextInt();
			} // for : 두번째 숫자열
			
			int[] L; int[] S;
			if (NI.length < MI.length)
				L = MI; S = NI;
			L = NI; S = MI;// if : 더 긴 숫자열 판별
			
			int max = 0;
			System.out.println(L.length);
			System.out.println(S.length);
			for (int i = 0; i < (L.length - S.length); i++) {
				int R = 0;
				String tmp = L.toString().substring(i, i + S.length);
				for (int j = 0; j < S.length; j++) {
					R += (tmp.charAt(j) - '0') * S[j];
				}
				System.out.println(R);
				if (R > max) {
					max = R;
				}
			}
			
			System.out.printf("#%d %d\n", tc, max);
		} // for : 테스트 결과 출력
	}
}
